{
  "name": "colyn-cli",
  "version": "3.4.3",
  "description": "专为并行 Vibe Coding 设计的 Git Worktree 管理工具",
  "type": "module",
  "bin": "./bin/colyn",
  "files": [
    "dist/",
    "bin/",
    "shell/",
    "skills/",
    "README.md",
    "README-en.md"
  ],
  "scripts": {
    "dev": "tsc --watch",
    "build": "tsc",
    "prepack": "yarn build",
    "colyn": "node dist/index.js",
    "install-to": "node scripts/install.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "git",
    "worktree",
    "cli",
    "development"
  ],
  "author": "Colin Han",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/colin-han/colyn.git"
  },
  "homepage": "https://github.com/colin-han/colyn#readme",
  "bugs": {
    "url": "https://github.com/colin-han/colyn/issues"
  },
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "chokidar": "^5.0.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.0.0",
    "deepmerge": "^4.3.1",
    "dotenv": "^16.4.0",
    "enquirer": "^2.4.1",
    "i18next": "^25.8.0",
    "js-yaml": "^4.3.0",
    "json5": "^2.2.3",
    "ora": "^8.0.1",
    "simple-git": "^3.22.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/js-yaml": "^4",
    "@types/node": "^20.11.0",
    "@vitest/ui": "^4.1.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
